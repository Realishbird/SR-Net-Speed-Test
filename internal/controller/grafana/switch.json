  {
   "type": "row",
   "title": "Throughput",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Ingress Gbps per port (gNMI, 30 s)",
   "description": "Bytes received by the switch on each port. gNMI samples every 30 s (the fastest Enterprise SONiC accepts), so short bursts are averaged.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Gbps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 60000
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "((rate({__name__=~\"srnet_gnmi_.*counters_in_octets\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names) * 8 / 1e9) * on(interface_name) group_left(host, host_port, fabric) label_replace(srnet_switch_port_info{switch=~\"(?i)$switch\"}, \"interface_name\", \"$1\", \"port\", \"(.*)\")) or ((rate({__name__=~\"srnet_gnmi_.*counters_in_octets\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names) * 8 / 1e9) unless on(interface_name) label_replace(srnet_switch_port_info{switch=~\"(?i)$switch\"}, \"interface_name\", \"$1\", \"port\", \"(.*)\"))",
     "legendFormat": "{{interface_name}} {{host}} {{host_port}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Egress Gbps per port (gNMI, 30 s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
