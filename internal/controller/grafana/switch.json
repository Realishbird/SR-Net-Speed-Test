    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "srnet_switch_rx_gbps{switch=~\"(?i)$switch\",port=~\"$port\"}",
     "legendFormat": "{{port}} in"
    },
    {
     "refId": "B",
     "expr": "srnet_switch_tx_gbps{switch=~\"(?i)$switch\",port=~\"$port\"}",
     "legendFormat": "{{port}} out"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Utilisation (% of line rate)",
   "description": "Ingress and egress rate against the port's configured speed (ifHighSpeed). A 100G port carrying 98 Gbps is at 98%.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 60000,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(rate({__name__=~\"srnet_gnmi_.*counters_(in|out)_octets\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names)) * 8 / 1e6 / on(interface_name) group_left() label_replace(srnet_switch_speed_mbps{switch=~\"(?i)$switch\"}, \"interface_name\", \"$1\", \"port\", \"(.*)\") * 100",
     "legendFormat": "{{interface_name}} {{__name__}}"
    }
   ]
  },
