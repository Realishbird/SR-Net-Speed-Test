{
 "uid": "srnet-switch",
 "title": "SR-Net: Switch",
 "tags": [
  "srnet",
  "switch"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "editable": true,
 "description": "Everything the controller reads from the switch itself, over gNMI (gnmic streams every 30 s, the fastest Enterprise SONiC accepts) and SNMP (every 30 s, every 2 s on the ports in use while a run is active): throughput, queue drops, ECN, PFC, buffers, errors, FEC, optics and switch health. Open it from a run page with \"Switch view\" to land on the run's time range and ports.",
 "annotations": {
  "list": [
   {
    "name": "Runs",
    "datasource": {
     "type": "prometheus",
     "uid": "srnet-vm"
    },
    "enable": true,
    "iconColor": "rgba(0, 150, 255, 0.8)",
    "expr": "max by (run_id) (srnet_rdma_rx_gbps{run_id!=\"\"})",
    "step": "15s",
    "titleFormat": "Run {{run_id}}",
    "tagKeys": "run_id",
    "textFormat": "Test traffic from the controller's run {{run_id}}",
    "useValueForTime": false
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "switch",
    "label": "Switch",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "srnet-vm"
    },
    "query": {
     "query": "label_values({__name__=~\"srnet_gnmi_.*counters_in_octets\"}, source)",
     "refId": "v"
    },
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "current": {},
    "description": "gNMI target name (the switch's name in the controller, lower-cased by gnmic)."
   },
   {
    "name": "port",
    "label": "Ports",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "srnet-vm"
    },
    "query": {
     "query": "label_values({__name__=~\"srnet_gnmi_.*counters_in_octets\",source=~\"(?i)$switch\"}, interface_name)",
     "refId": "v"
    },
    "refresh": 2,
    "sort": 7,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "description": "Pick the switch ports to look at. The run page's Switch view button pre-selects the run's ports."
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Ports up",
   "description": "Ports with link, from the SNMP walk every 30 s.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(srnet_switch_up{switch=~\"(?i)$switch\"} == 1)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Total in",
   "description": "Sum of the selected ports' ingress, 2 minute rate.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Gbps",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({__name__=~\"srnet_gnmi_.*counters_in_octets\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names)) * 8 / 1e9"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Total out",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Gbps",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({__name__=~\"srnet_gnmi_.*counters_out_octets\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names)) * 8 / 1e9"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Queue drops /s",
   "description": "Packets dropped in egress queues of the selected ports. Any value above 0 under load means the fabric is lossy for that traffic.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.001
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "none",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({__name__=~\"srnet_gnmi_.*queues.*_dropped_pkts\",source=~\"(?i)$switch\",interface_interface_id=~\"$port\"}[2m] keep_metric_names))"
    }
   ]
  },
  {
   "type": "stat",
   "title": "PFC pause /s",
   "description": "Priority flow control pause frames received plus sent. 0 on this fabric means PFC is off or never needed.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.001
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "none",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({__name__=~\"srnet_gnmi_.*pfc.*pause_frames_(rx|tx)\",source=~\"(?i)$switch\",interface_interface_id=~\"$port\"}[2m] keep_metric_names))"
    }
   ]
  },
  {
   "type": "stat",
   "title": "CRC errors /s",
   "description": "Frames failing the CRC: a bad cable or optic.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.001
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "none",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({__name__=~\"srnet_gnmi_.*ethernet_state_counters_in_crc_errors\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names))"
    }
   ]
  },
