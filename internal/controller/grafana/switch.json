   "targets": [
    {
     "refId": "A",
     "expr": "((rate({__name__=~\"srnet_gnmi_.*counters_out_octets\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names) * 8 / 1e9) * on(interface_name) group_left(host, host_port, fabric) label_replace(srnet_switch_port_info{switch=~\"(?i)$switch\"}, \"interface_name\", \"$1\", \"port\", \"(.*)\")) or ((rate({__name__=~\"srnet_gnmi_.*counters_out_octets\",source=~\"(?i)$switch\",interface_name=~\"$port\"}[2m] keep_metric_names) * 8 / 1e9) unless on(interface_name) label_replace(srnet_switch_port_info{switch=~\"(?i)$switch\"}, \"interface_name\", \"$1\", \"port\", \"(.*)\"))",
     "legendFormat": "{{interface_name}} {{host}} {{host_port}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Port Gbps during runs (SNMP, 2 s)",
   "description": "While a run is active the controller polls the ports that are up every 2 s over SNMP; between runs every 30 s. This is the view to compare with the host NIC counters second by second.",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Gbps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
