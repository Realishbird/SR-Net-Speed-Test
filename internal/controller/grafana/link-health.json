{
 "uid": "srnet-link-health",
 "title": "SR-Net: Link health",
 "tags": [
  "srnet"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "srnet-vm"
    },
    "query": {
     "query": "label_values(srnet_rdma_port_active, host)",
     "refId": "v"
    },
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "RDMA error counters (increase per 5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host, rdma_dev, __name__) (increase(srnet_rdma_hw_out_of_sequence{host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{rdma_dev}} {{__name__}}"
    },
    {
     "refId": "B",
     "expr": "sum by (host, rdma_dev, __name__) (increase(srnet_rdma_hw_packet_seq_err{host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{rdma_dev}} {{__name__}}"
    },
    {
     "refId": "C",
     "expr": "sum by (host, rdma_dev, __name__) (increase(srnet_rdma_hw_local_ack_timeout_err{host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{rdma_dev}} {{__name__}}"
    },
    {
     "refId": "D",
     "expr": "sum by (host, rdma_dev, __name__) (increase(srnet_rdma_hw_rnr_nak_retry_err{host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{rdma_dev}} {{__name__}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "NIC symbol / FEC / CRC errors (increase per 5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host, netdev, __name__) (increase(srnet_nic_rx_symbol_err_phy{host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{netdev}} {{__name__}}"
    },
    {
     "refId": "B",
     "expr": "sum by (host, netdev, __name__) (increase({__name__=~\"srnet_nic_rx_(corrected_bits_phy|fec_corrected_blocks_phy|fec_corrected_blocks|fec_uncorrectable_blocks|fec_corrected_bits|corrected_bits)\",host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{netdev}} {{__name__}}"
    },
    {
     "refId": "C",
     "expr": "sum by (host, netdev, __name__) (increase(srnet_nic_rx_crc_errors_phy{host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{netdev}} {{__name__}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Transceiver temperature",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, netdev) (srnet_dom_temp_c{host=~\"$host\"})",
     "legendFormat": "{{host}} {{netdev}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Transceiver TX bias (ch1)",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 8,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "mamp",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, netdev) (srnet_dom_tx_bias_ma{host=~\"$host\",sub=\"ch1\"})",
     "legendFormat": "{{host}} {{netdev}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Transceiver RX optical power",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 16,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "mwatt",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, netdev, sub) (srnet_dom_rx_power_mw{host=~\"$host\"})",
     "legendFormat": "{{host}} {{netdev}} {{sub}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Link carrier changes",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, netdev) (srnet_link_carrier_changes{host=~\"$host\"})",
     "legendFormat": "{{host}} {{netdev}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Link speed",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 8,
    "y": 17,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Gbps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, netdev) (srnet_link_speed_mbps{host=~\"$host\"})/1000",
     "legendFormat": "{{host}} {{netdev}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Pause frames (rate)",
   "datasource": {
    "type": "prometheus",
    "uid": "srnet-vm"
   },
   "gridPos": {
    "x": 16,
    "y": 17,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host, netdev, __name__) (rate({__name__=~\"srnet_nic_rx_(prio[0-9]_pause|pause_ctrl_phy|global_pause)\",host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{netdev}} {{__name__}}"
    },
    {
     "refId": "B",
     "expr": "sum by (host, netdev, __name__) (rate({__name__=~\"srnet_nic_tx_(prio[0-9]_pause|pause_ctrl_phy|global_pause)\",host=~\"$host\"}[5m]) keep_metric_names)",
     "legendFormat": "{{host}} {{netdev}} {{__name__}}"
    }
   ]
  }
 ]
}
